# Use a random hex password (e.g. openssl rand -hex 32), safe inside DATABASE_URL.
MARIADB_PASSWORD=replace-with-a-random-hex-password
TUNNEL_PORT=443
# Copy config/server.example.json here and customize it before starting.
# Keep bind_address on container port 443.
SERVER_CONFIG=./config/server.json
# Container UID/GID must own config/ AND server.json (which is mode 0600).
# For a deployment owned by your login, use id -u and id -g.
# When deploying as root, keep a non-root UID/GID here and chown config/ to it.
TUNNEL_UID=1000
TUNNEL_GID=1000
# Optional, only with compose.local.yaml (MariaDB remains bound to loopback).
MARIADB_LOCAL_PORT=3306
